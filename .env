# ============================================================
#  JARVIS Face Recognition System — Environment Configuration
# ============================================================

# --- MongoDB Connection ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=jarvis_db
MONGO_COLLECTION_PERSONS=persons
MONGO_COLLECTION_LOGS=recognition_logs

# --- Camera Settings ---
CAMERA_INDEX=0                  # 0 = default webcam, 1 = external
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# --- Face Recognition Settings ---
FACE_RECOGNITION_THRESHOLD=0.45   # Lower = stricter match (0.0–1.0)
FACE_DETECTION_MODEL=buffalo_s    # InsightFace model: buffalo_l | buffalo_sc
FACE_EMBED_SIZE=512

# --- Target Lock Settings ---
TARGET_LOCK_DURATION=10           # Seconds to hold lock on recognized face
SPOTLIGHT_DIM_ALPHA=0.75          # Background dimming (0.0–1.0)
ZOOM_SMOOTHING=0.15               # Zoom transition speed

# --- UI Settings ---
HUD_COLOR_PRIMARY=0,255,70        # Neon green (R,G,B)
HUD_COLOR_ACCENT=0,180,255        # Cyan (R,G,B)
HUD_COLOR_ALERT=255,60,60         # Red (R,G,B)
HUD_FONT_SCALE=0.55
FULLSCREEN=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/jarvis.log
