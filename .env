# ============================================================
#  JARVIS Face Recognition System — Environment Configuration
# ============================================================

# --- MongoDB Connection ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=jarvis_db
MONGO_COLLECTION_PERSONS=persons
MONGO_COLLECTION_LOGS=recognition_logs

# --- Camera Settings ---
CAMERA_INDEX=0                  # 0 = default webcam, 1 = external
CAMERA_WIDTH=960
CAMERA_HEIGHT=540
CAMERA_FPS=30

# --- Face Recognition Settings ---
FACE_RECOGNITION_THRESHOLD=0.45   # Lower = stricter match (0.0–1.0)
FACE_DETECTION_MODEL=buffalo_s    # InsightFace model: buffalo_l | buffalo_s
FACE_EMBED_SIZE=512
FACE_FRAME_SKIP=3
FACE_PROCESS_MAX_WIDTH=448

# --- Target Lock Settings ---
TARGET_LOCK_DURATION=10           # Seconds to hold lock on recognized face
ZOOM_SMOOTHING=0.15               # Zoom transition speed

# --- UI Settings ---
HUD_COLOR_PRIMARY=0,255,70        # Neon green (R,G,B)
HUD_COLOR_ACCENT=0,180,255        # Cyan (R,G,B)
HUD_COLOR_ALERT=255,60,60         # Red (R,G,B)
HUD_FONT_SCALE=0.55
FULLSCREEN=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=logs/jarvis.log

# --- Audio ---
MICROPHONE_DEVICE_INDEX=
WHISPER_LANGUAGE=en
GROQ_API_KEY=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
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_SEC=12
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_CHAT_TIMEOUT_SEC=8
AUDIO_MIN_RMS=0
AUDIO_ENERGY_THRESHOLD=80
AUDIO_PAUSE_THRESHOLD=1.0
AUDIO_NON_SPEAKING_DURATION=0.4
AUDIO_LISTEN_TIMEOUT_SEC=1.0
AUDIO_PHRASE_TIME_LIMIT_SEC=6.0
COMMAND_TIMEOUT_SEC=5
OBJECT_DB_CONF_THRESHOLD=0.50
OBJECT_IMGSZ=256
OBJECT_FRAME_SKIP=4
VISION_TARGET_FPS=8
HUD_SPOTLIGHT_ENABLED=false
SPOTLIGHT_PADDING=48

# --- Ollama / Gemma 4 ---
OLLAMA_MODEL=gemma4:e4b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=15m
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.4
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64
OLLAMA_NUM_CTX=8192
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_MAX_WIDTH=800
OLLAMA_VISION_JPEG_QUALITY=80
REASONING_TIMEOUT_SEC=10
NAME_MATCH_TIMEOUT_SEC=1.2
TTS_ENABLED=true
TTS_VOICE=David
TTS_RATE=1
TTS_VOLUME=100
